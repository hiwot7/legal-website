generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  role         Role        @default(ADMIN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  teamProfile  TeamMember?
  posts        Post[]
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  bio       String
  photo     Bytes?
  photoType String?
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  email        String
  phone        String?
  practiceArea String?
  message      String
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

enum PostType {
  ARTICLE
  CASE_STUDY
}

model Post {
  id              String        @id @default(cuid())
  type            PostType      @default(ARTICLE)
  slug            String        @unique
  title           String
  excerpt         String
  body            String
  coverImage      Bytes?
  coverImageType  String?
  metaTitle       String?
  metaDescription String?
  status          ContentStatus @default(DRAFT)
  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Testimonial {
  id         String        @id @default(cuid())
  clientName String
  clientRole String?
  quote      String
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model SiteImage {
  key       String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
}

model SiteContent {
  key       String   @id
  valueEn   String
  valueAm   String
  valueOm   String
  updatedAt DateTime @updatedAt
}

model CaseRecord {
  id        String   @id @default(cuid())
  caseId    String   @unique
  client    String
  phone     String?
  attorney  String
  court     String
  status    String
  ketero    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
