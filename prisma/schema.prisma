generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  role         Role        @default(ADMIN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  teamProfile  TeamMember?
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  bio       String
  photo     Bytes?
  photoType String?
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  email        String
  phone        String?
  practiceArea String?
  message      String
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CaseRecord {
  id        String   @id @default(cuid())
  caseId    String   @unique
  client    String
  phone     String?
  attorney  String
  court     String
  status    String
  ketero    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
